# Credenciais da API do TMDB (https://www.themoviedb.org/settings/api)
# Preencha pelo menos UMA das duas. O token de leitura (v4) é o recomendado.

# "Token de leitura da API" (v4, começa com eyJ...)
TMDB_API_READ_TOKEN=

# "Chave da API" (v3, 32 caracteres hexadecimais) — usada apenas se o token acima estiver vazio
TMDB_API_KEY=

# Banco de dados PostgreSQL (contas e avaliações sincronizadas).
# Este valor corresponde ao banco do compose.yaml: suba com `npm run db:up`.
DATABASE_URL=postgres://recomenda:recomenda@localhost:5433/recomenda_filmes

# Conexão direta (sem pooler), usada só pelas migrações. Opcional: sem ela, usa o DATABASE_URL.
# Em produção com Neon, a integração da Vercel preenche esta variável sozinha.
DATABASE_URL_UNPOOLED=

# Segredo que assina as sessões. Gere um valor aleatório com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Endereço público do app (usado nos links enviados por e-mail e no retorno do login com Google)
BETTER_AUTH_URL=http://localhost:3000

# Login com Google (opcional — sem estas duas, o botão do Google não aparece).
# Crie em https://console.cloud.google.com/apis/credentials (ID do cliente OAuth, tipo "Aplicativo da Web")
# com o URI de redirecionamento: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de e-mails (recuperação de senha), ex.: smtps://usuario:senha@smtp.exemplo.com:465
# Sem SMTP_URL, em desenvolvimento o e-mail (com o link) aparece no terminal do `npm run dev`.
SMTP_URL=
EMAIL_FROM="Recomenda Filmes <nao-responda@exemplo.com>"
