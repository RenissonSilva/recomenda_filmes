# Credenciais da API do TMDB (https://www.themoviedb.org/settings/api)
# Preencha pelo menos UMA das duas. O token de leitura (v4) é o recomendado.

# "Token de leitura da API" (v4, começa com eyJ...)
TMDB_API_READ_TOKEN=

# "Chave da API" (v3, 32 caracteres hexadecimais) — usada apenas se o token acima estiver vazio
TMDB_API_KEY=
